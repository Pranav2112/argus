# Provider selection: OpenAI if OPENAI_API_KEY is set, else Anthropic if ANTHROPIC_API_KEY is set.
OPENAI_API_KEY=
# Required when OPENAI_API_KEY is set (no default). Use a model that supports Structured Outputs (json_schema).
OPENAI_MODEL=

ANTHROPIC_API_KEY=
# Optional; defaults to claude-sonnet-4-5
ANTHROPIC_MODEL=
